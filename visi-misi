                cat: 'ekosistem',
                title: 'Keteladanan Pimpinan di Sekolah',
                role: 'Rohaniwan & Guru',
                q: '“Apakah para pimpinan mampu menunjukkan keteladanan nyata, dan apakah nilai kasih benar-benar hidup saat ada kendala operasional?”'
            },
            {
                cat: 'ekosistem',
                title: 'Sinergi Pola Asuh Orang Tua',
                role: 'Guru SD',
                q: '“Bagaimana strategi membangun komunikasi agar nilai Kasih dan Disiplin yang diajarkan di kelas juga diterapkan oleh orang tua di rumah?”'
            },
            {
                cat: 'ekosistem',
                title: 'Kesinambungan Lintas Jenjang',
                role: 'Guru SD',
                q: '“Bagaimana menjaga agar pembentukan karakter tidak terhenti saat siswa naik jenjang (TK ke SD, SD ke SMP)?”'
            }
        ];

        document.addEventListener('DOMContentLoaded', function() {
            const ctxIndikator = document.getElementById('chartIndikator').getContext('2d');
            new Chart(ctxIndikator, {
                type: 'bar',
                data: {
                    labels: wrappedIndikatorLabels,
                    datasets: [{
                        label: 'Skor Rata-Rata (Skala 1.00 - 4.00)',
                        data: indikatorScores,
                        backgroundColor: indikatorScores.map(score => {
                            if (score >= 3.45) return '#0D9488';
                            if (score >= 3.30) return '#3B82F6';
                            return '#E11D48';
                        }),
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: standardTooltipConfig
                    },
                    scales: {
                        x: {
                            min: 1.0,
                            max: 4.0,
                            grid: { color: '#F1F5F9' },
                            ticks: { font: { size: 11 } }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { font: { size: 11, weight: '600' } }
                        }
                    }
                }
            });

            const ctxPeran = document.getElementById('chartPeran').getContext('2d');
            new Chart(ctxPeran, {
                type: 'doughnut',
                data: {
                    labels: wrappedPeranLabels,
                    datasets: [{
                        data: peranData,
                        backgroundColor: ['#2563EB', '#0D9488', '#F59E0B', '#6366F1'],
