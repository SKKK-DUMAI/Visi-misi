    <script>
        function wrapLabel(str, maxLen = 18) {
            if (typeof str !== 'string') return str;
            if (str.length <= maxLen) return str;
            const words = str.split(' ');
            const lines = [];
            let currentLine = '';
            
            words.forEach(word => {
                if ((currentLine + ' ' + word).trim().length > maxLen) {
                    if (currentLine) lines.push(currentLine.trim());
                    currentLine = word;
                } else {
                    currentLine = (currentLine + ' ' + word).trim();
                }
            });
            if (currentLine) lines.push(currentLine.trim());
            return lines;
        }

        const standardTooltipConfig = {
            callbacks: {
                title: function(tooltipItems) {
                    const item = tooltipItems[0];
                    let label = item.chart.data.labels[item.dataIndex];
                    if (Array.isArray(label)) {
                        return label.join(' ');
                    } else {
                        return label;
                    }
                }
            }
        };

        const rawIndikatorLabels = [
            '1. Relevansi Tuntutan Zaman',
            '2. Optimisme Kemajuan Lembaga',
            '3. Makna Nilai (Kasih, Disiplin, Berdaya)',
            '4. Relevansi dengan Kondisi Unit',
            '5. Pemahaman Arah Visi Baru',
            '6. Penguatan Panggilan Pribadi',
            '7. Peran Misi Mendukung Visi',
            '8. Kesiapan Peran Harian',
            '9. Kesiapan Sistem & Tim Unit',
            '10. Hafalan Teks Redaksional'
        ];
        const wrappedIndikatorLabels = rawIndikatorLabels.map(l => wrapLabel(l, 20));
        const indikatorScores = [3.51, 3.51, 3.47, 3.46, 3.44, 3.44, 3.39, 3.34, 3.32, 2.71];

        const rawPeranLabels = ['Guru', 'Staf Operasional', 'Kepala Sekolah', 'Lainnya / Pimpinan'];
        const wrappedPeranLabels = rawPeranLabels.map(l => wrapLabel(l, 16));
        const peranData = [79.3, 9.8, 6.4, 4.5];

        const rawUnitLabels = ['SD', 'SMP', 'KB / TK', 'SMA / SMK / Lainnya'];
        const wrappedUnitLabels = rawUnitLabels.map(l => wrapLabel(l, 16));
        const unitData = [58.4, 18.7, 13.7, 9.2];

        const questionsData = [
            {
                cat: 'metodologi',
                title: 'Integrasi di Mapel Eksakta (Matematika)',
                role: 'Guru SMP',
                q: '“Bagaimana cara mengintegrasikan nilai-nilai VMN ke dalam mata pelajaran eksakta seperti Matematika agar tidak terkesan dipaksakan?”'
            },
            {
                cat: 'metodologi',
                title: 'Penerapan di Kelas Olahraga (PJOK)',
                role: 'Guru PJOK',
                q: '“Bagaimana mengintegrasikan nilai VMN ke dalam pembelajaran PJOK agar tidak berfokus pada fisik saja, melainkan membentuk karakter & disiplin?”'
            },
            {
                cat: 'metodologi',
                title: 'Layanan Bimbingan Konseling (BK)',
                role: 'Guru BK SD',
                q: '“Bagaimana menerjemahkan VMN yang baru ke dalam program Bimbingan Konseling (BK) yang sesuai dengan kebutuhan anak SD?”'
            },
            {
                cat: 'metodologi',
                title: 'Pendidikan Anak Usia Dini (PAUD/TK)',
                role: 'Guru KB/TK',
                q: '“Bagaimana cara mengintegrasikan nilai-nilai ini secara sederhana, konkret, dan menyenangkan sesuai tahap anak TK?”'
            },
            {
                cat: 'metodologi',
                title: 'Kegiatan Pengenalan Sekolah (MPLS)',
                role: 'Guru SD',
                q: '“Bagaimana langkah mengenalkan VMN dalam kegiatan MPLS bagi anak-anak murid baru secara menarik?”'
            },
            {
                cat: 'asesmen',
                title: 'Pengukuran & Rubrik Nilai Inti',
                role: 'Guru SMP',
                q: '“Bagaimana indikator keberhasilan penerapan nilai Kasih, Disiplin, dan Berdaya Guna akan diukur secara nyata & adil?”'
            },
            {
                cat: 'asesmen',
                title: 'Standar Kelulusan Transformasi',
                role: 'Kepala Sekolah SMP',
                q: '“Bagaimana cara sekolah memastikan bahwa setiap murid yang lulus benar-benar sudah bertransformasi karakter?”'
            },
            {
                cat: 'asesmen',
                title: 'Hubungan dengan KPI / Kinerja Guru',
