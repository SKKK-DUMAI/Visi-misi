                    labels: wrappedUnitLabels,
                    datasets: [{
                        data: unitData,
                        backgroundColor: ['#0D9488', '#3B82F6', '#F97316', '#8B5CF6'],
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { boxWidth: 12, font: { size: 10 } }
                        },
                        tooltip: standardTooltipConfig
                    },
                    cutout: '65%'
                }
            });

            const ctxStatusCabang = document.getElementById('chartStatusCabang').getContext('2d');
            new Chart(ctxStatusCabang, {
                type: 'pie',
                data: {
                    labels: ['Cabang Berpartisipasi (13)', 'Cabang Belum Mengisi (16)'],
                    datasets: [{
                        data: [13, 16],
                        backgroundColor: ['#10B981', '#E11D48'],
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, font: { size: 11, weight: '600' } }
                        },
                        tooltip: standardTooltipConfig
                    }
                }
            });

            renderQuestions('all');
        });

        function renderQuestions(filter) {
            const grid = document.getElementById('questionsGrid');
            grid.innerHTML = '';

            const filtered = questionsData.filter(q => {
                if (filter === 'all') return true;
                return q.cat === filter;
            });

            filtered.forEach(item => {
                let catBadge = 'bg-brand-50 text-brand-800 border-brand-200';
                let icon = 'fa-book-bookmark';

                if (item.cat === 'asesmen') {
                    catBadge = 'bg-teal-50 text-vibrant-teal border-teal-200';
                    icon = 'fa-clipboard-check';
                } else if (item.cat === 'ekosistem') {
                    catBadge = 'bg-amber-50 text-amber-800 border-amber-200';
                    icon = 'fa-people-roof';
                }

                const cardHtml = `
                    <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 hover:border-brand-500 transition flex flex-col justify-between">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-1 rounded-md text-[10px] font-bold border ${catBadge} inline-flex items-center">
                                    <i class="fa-solid ${icon} mr-1"></i> ${item.cat.toUpperCase()}
                                </span>
                                <span class="text-xs font-semibold text-slate-500">${item.role}</span>
                            </div>
                            <h5 class="font-bold text-slate-900 text-sm leading-snug">${item.title}</h5>
                            <p class="text-xs text-slate-600 italic bg-slate-50 p-3 rounded-xl border border-slate-100 leading-relaxed">
                                ${item.q}
                            </p>
                        </div>
                        <div class="mt-3 pt-2 text-[10px] text-slate-400 font-medium flex items-center justify-between">
                            <span><i class="fa-solid fa-comment-dots mr-1"></i> Isian Survei Awareness</span>
                            <span class="text-brand-600 font-semibold">Bahan Sosialisasi Lanjutan</span>
                        </div>
                    </div>
                `;
                grid.innerHTML += cardHtml;
            });
        }

        function filterQuestions(category) {
            ['all', 'metodologi', 'asesmen', 'ekosistem'].forEach(c => {
                const btn = document.getElementById(`qbtn-${c}`);
                if (c === category) {
                    btn.className = "px-4 py-2 rounded-xl bg-brand-800 text-white shadow-sm transition";
                } else {
                    btn.className = "px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition";
                }
            });
            renderQuestions(category);
        }
    </script>
